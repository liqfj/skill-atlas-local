{
  "name": "skill-atlas-local",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "A local, read-only inventory of installed agent skills.",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "scripts": {
    "start": "node server.mjs",
    "scan": "node cli.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "licenses:write": "node scripts/licenses.mjs --write",
    "licenses:check": "node scripts/licenses.mjs",
    "release:check": "node scripts/release.mjs",
    "release": "node scripts/release.mjs --build"
  },
  "files": [
    ".gitattributes",
    ".gitignore",
    ".github/workflows/ci.yml",
    ".github/dependabot.yml",
    ".github/ISSUE_TEMPLATE/bug_report.yml",
    ".github/ISSUE_TEMPLATE/feature_request.yml",
    ".github/ISSUE_TEMPLATE/config.yml",
    ".github/pull_request_template.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "RELEASE.md",
    "CHANGELOG.md",
    "package.json",
    "package-lock.json",
    "config.json",
    "server.mjs",
    "cli.mjs",
    "src/catalog.mjs",
    "src/classification.mjs",
    "src/http.mjs",
    "src/introductions.mjs",
    "src/markdown.mjs",
    "src/packages.mjs",
    "src/presentation.mjs",
    "src/store.mjs",
    "public/index.html",
    "public/app.js",
    "public/style.css",
    "scripts/check.mjs",
    "scripts/licenses.mjs",
    "scripts/release.mjs",
    "tests/app.test.mjs",
    "tests/catalog.test.mjs",
    "tests/release.test.mjs",
    "tests/browser-fixture.mjs",
    "docs/preview.png"
  ],
  "dependencies": {
    "lucide": "1.47.0",
    "marked": "18.0.14",
    "sanitize-html": "2.17.7",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "tar": "7.5.22"
  }
}
